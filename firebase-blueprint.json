{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profiles with roles within the church",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "pastor", "pastora", "leader", "obreiro", "presbítero", "missionário", "missionária", "diácono", "evangelista", "diaconisa", "mídia social", "membro"] },
        "departmentId": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role", "email"]
    },
    "Department": {
      "title": "Church Department",
      "description": "Organizational departments of the church",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "leader": { "type": "string" },
        "description": { "type": "string" },
        "meetingDay": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "Report": {
      "title": "Monthly Report",
      "description": "Monthly activity reports from departments or pastoral",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["pastoral", "department", "spiritual", "construction"] },
        "departmentId": { "type": "string" },
        "departmentName": { "type": "string" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "content": { "type": "string" },
        "nextMonthProjection": { "type": "string" },
        "positives": { "type": "string" },
        "negatives": { "type": "string" },
        "difficulties": { "type": "string" },
        "testimonies": { "type": "string" },
        "needs": { "type": "string" },
        "metrics": {
          "type": "object",
          "properties": {
            "attendance": { "type": "number" },
            "conversions": { "type": "number" },
            "reconciliations": { "type": "number" },
            "baptisms": { "type": "number" },
            "servicesCount": { "type": "number" },
            "visitsCount": { "type": "number" },
            "peopleVisitedCount": { "type": "number" }
          }
        },
        "enviadoById": { "type": "string" },
        "enviadoByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["draft", "enviado"] }
      },
      "required": ["type", "month", "year", "content", "enviadoById"]
    },
    "Transaction": {
      "title": "Financial Transaction",
      "description": "Income or expense record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "personName": { "type": "string" },
        "paymentMethod": { "type": "string", "enum": ["pix", "dinheiro", "outros"] },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "amount", "date"]
    },
    "Member": {
      "title": "Church Member",
      "description": "Full record of a church member",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "birthDate": { "type": "string", "format": "date" },
        "department": { "type": "string" },
        "position": { "type": "string", "enum": ["Membro", "Pastor", "Pastora", "Presbítero", "Missionária", "Missionário", "Diácono", "Evangelista"] },
        "conversionDate": { "type": "string", "format": "date" },
        "isBaptized": { "type": "boolean" },
        "isSpiritBaptized": { "type": "boolean" },
        "isTither": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "inactive", "visitor"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "Event": {
      "title": "Church Event",
      "description": "Calendar events and appointments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "category": { "type": "string", "enum": ["Cultos", "Reuniões", "Congressos", "Social"] },
        "description": { "type": "string" }
      },
      "required": ["title", "date", "time", "location", "category"]
    },
    "ConstructionItem": {
      "title": "Construction & Purchasing Item",
      "description": "Materials or services bought for construction or maintenance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "unitPrice": { "type": "number" },
        "totalPrice": { "type": "number" },
        "category": { "type": "string", "enum": ["Material de Construção", "Mão de Obra", "Mobília", "Equipamentos", "Outros"] },
        "date": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "totalPrice", "date"]
    },
    "Asset": {
      "title": "Church Asset",
      "description": "Church inventory items like chairs, tables, microphones, instruments, cables, air conditioning and projectors",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["Microfones", "Cabos & Conectores", "Instrumentos Musicais", "Som & Áudio", "Projetores & Telões", "Ar Condicionado & Ventilação", "Iluminação", "Mobiliário", "Outros"] },
        "quantity": { "type": "number" },
        "condition": { "type": "string", "enum": ["Novo", "Bom", "Regular", "Precisa de Manutenção", "Danificado"] },
        "status": { "type": "string", "enum": ["Em uso", "Em manutenção", "Reparado", "Reserva / Almoxarifado", "Baixado"] },
        "location": { "type": "string" },
        "serialNumber": { "type": "string" },
        "notes": { "type": "string" },
        "lastInventoryDate": { "type": "string", "format": "date" }
      },
      "required": ["name", "quantity"]
    },
    "CleaningSchedule": {
      "title": "Cleaning and Temple Care Schedule",
      "description": "Cleaning groups and maintenance tasks before and after services",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "targetService": { "type": "string" },
        "leaderName": { "type": "string" },
        "leaderPhone": { "type": "string" },
        "teamMembers": { "type": "array", "items": { "type": "string" } },
        "areas": { "type": "array", "items": { "type": "string" } },
        "checklist": { "type": "array" },
        "status": { "type": "string", "enum": ["Agendada", "Em andamento", "Concluída", "Cancelada"] },
        "observations": { "type": "string" },
        "completedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "date", "leaderName"]
    },
    "Worker": {
      "title": "Church Worker/Leader",
      "description": "Details of church leaders and ministry workers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "whatsapp": { "type": "string" },
        "category": { "type": "string" },
        "border": { "type": "string" },
        "ministryStartDate": { "type": "string", "format": "date" },
        "isBaptizedInWater": { "type": "boolean" },
        "isBaptizedInSpirit": { "type": "boolean" },
        "isTither": { "type": "boolean" },
